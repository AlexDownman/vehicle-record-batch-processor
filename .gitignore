# Data: the DVSA seed files are several GB, and the batch folders hold
# runtime output. Keep the folder structure (via .gitkeep), not the contents.
/data/*
!/data/seed/
!/data/inbound/
!/data/archive/
!/data/rejects/
!/data/reports/
!/data/logs/
!/data/work/
/data/*/*
!/data/*/.gitkeep

# Oracle / SQL*Loader output
*.bad
*.dsc
*.log

# Local AI assistant instructions (not part of the project)
CLAUDE.md

# Python virtualenv (recreate with: python3 -m venv .venv && .venv/bin/pip install -r requirements.txt)
.venv/
__pycache__/
